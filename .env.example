# 把这个文件复制成 .env，按需要改。docker compose 会自动读。
#   cp .env.example .env

# 门牌
LITTLE_CHEF_HOUSE_NAME=littlechef
LITTLE_CHEF_HOUSE_SUBTITLE=家庭菜谱

# 编辑口令：留空 = 家里网络内谁都能改；填了之后前端第一次编辑会问一次，记在浏览器里
LITTLE_CHEF_EDIT_PIN=

# 只读模式（1 = 谁都改不了，适合投屏或者对外分享）
LITTLE_CHEF_READ_ONLY=0

# ---------------------------------------------------------------------------
# 配图用的大模型。三选一，或者 none。
# none 也不会开天窗：后端会画一张水彩感的 SVG 占位图。
# ---------------------------------------------------------------------------
LITTLE_CHEF_IMAGE_PROVIDER=none
LITTLE_CHEF_IMAGE_SIZE=1328x992

# 1) 火山方舟 / 豆包 Seedream（国内 NAS 最省事，速度也快）
#    LITTLE_CHEF_IMAGE_PROVIDER=ark
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 2) OpenAI 兼容接口（含各种中转）
#    LITTLE_CHEF_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3) 家里自己跑的 Stable Diffusion WebUI / Forge（完全不出门）
#    LITTLE_CHEF_IMAGE_PROVIDER=sdwebui
SD_WEBUI_URL=http://127.0.0.1:7860
# SD_STEPS=28
# SD_CFG=6.5
# SD_SAMPLER=DPM++ 2M

# 拍照识别：支持图片输入的 Chat Completions 兼容服务，模型 ID 必填
LITTLE_CHEF_VISION_BASE_URL=https://api.openai.com/v1
LITTLE_CHEF_VISION_MODEL=
LITTLE_CHEF_VISION_API_KEY=
# 照片转手绘：必须支持图片编辑 /images/edits（文生图接口不能替代）
LITTLE_CHEF_PHOTO_EDIT_BASE_URL=https://api.openai.com/v1
LITTLE_CHEF_PHOTO_EDIT_MODEL=gpt-image-1
LITTLE_CHEF_PHOTO_EDIT_API_KEY=
# 以上两个 API Key 留空时复用 OPENAI_API_KEY；使用其他服务时请填写各自的 Key。
